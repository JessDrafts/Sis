.model morracinese
.inputs P1 P0 S1 S0 I
.outputs MAN1 MAN0 PAR1 PAR0

.subckt DATAPATH PRIMO1=P1 PRIMO0=P0 SECONDO1=S1 SECONDO0=S0 INIZIA=I MANCHE1=MAN1 MANCHE0=MAN0 fine=FINE pobbligatorio=POBBLIGATORIO

.subckt FSM_MANUALE MANCHE1=MAN1 MANCHE0=MAN0 pobbligatorio=POBBLIGATORIO fine=FINE INIZIA=I PARTITA1=PAR1 PARTITA0=PAR0


.end
.search FSM.blif
.search DATAPATH.blif
